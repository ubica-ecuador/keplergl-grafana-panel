# Local dev secrets consumed by docker-compose. Copy to .env and fill in.
# .env is gitignored; this file is not.

# Password of the MobilityDB/PostgreSQL container reached at
# host.docker.internal:45432. Only needed if you add that data source by hand —
# it is no longer provisioned.
MOBILITYDB_PASSWORD=

# TriMet (Portland) AppID for the trimet-live dashboard, free from
# https://developer.trimet.org/appid/registration/. The sources-data proxy adds
# it to every request, so it never appears in the dashboard.
TRIMET_APP_ID=
