        "definition": "SELECT replace(assets.aws.alternate.s3.href, 's3://overturemaps-us-west-2/',\n               'https://overturemaps-us-west-2.s3.us-west-2.amazonaws.com/') AS href\nFROM 'https://stac.overturemaps.org/${ov_release}/collections.parquet'\nWHERE collection = 'segment' AND bbox.xmin <= -78.87 AND bbox.xmax >= -79.11 AND bbox.ymin <= -2.76 AND bbox.ymax >= -3.02",
