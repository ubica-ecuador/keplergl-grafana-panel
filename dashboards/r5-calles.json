        "definition": "CREATE TABLE IF NOT EXISTS \"calles_ov_${ov_release}\" AS\nWITH s AS (\n  SELECT id, class, geometry AS g,\n         greatest(1, ceil(ST_Length(geometry) * 111320 / 50))::INT AS n\n  FROM read_parquet('${ov_url}')\n  WHERE subtype = 'road' AND bbox.xmin <= -78.87 AND bbox.xmax >= -79.11 AND bbox.ymin <= -2.76 AND bbox.ymax >= -3.02\n)\nSELECT id, class, ST_LineSubstring(g, i / n, (i + 1) / n) AS g FROM s, range(n) r(i)",
