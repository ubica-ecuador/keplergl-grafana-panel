      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawSql": "-- Waits on $calles, which materialises Overture's streets once per dashboard load.\nSELECT c.minutos, s.class,\n       (($fecha || ' 07:00:00')::TIMESTAMP + INTERVAL (c.minutos) MINUTE) AS time,\n       ST_AsHEXWKB(s.g) AS geom\nFROM \"calles_ov_${ov_release:raw}\" s\nJOIN (SELECT minutos, ST_GeomFromHEXWKB(geom) AS cg FROM read_json_auto('http://host.docker.internal:8099/cells.json?' || 'lat=' || $lat || '&lon=' || $lng || '&date=' || $fecha ||\n         '&calle=' || $calle || '&transit=${publico:csv}' ||\n         '&walk=' || $apie || '&rides=' || $trasbordos || '&max=' || $cutoff)) c\n  ON ST_Within(ST_LineInterpolatePoint(s.g, 0.5), c.cg)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawSql": "SELECT try_cast($lat AS DOUBLE) AS latitude, try_cast($lng AS DOUBLE) AS longitude",
          "refId": "B"
        }
      ],
      "title": "Every street reachable from the white dot, coloured by the minute R5 reaches it",
      "type": "ubica-keplergl-panel"
    }
  ],
