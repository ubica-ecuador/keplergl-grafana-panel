diff --git a/rio_tiler/experimental/_zarr.py b/rio_tiler/experimental/_zarr.py
index 19ee7e4..f6040a5 100644
--- a/rio_tiler/experimental/_zarr.py
+++ b/rio_tiler/experimental/_zarr.py
@@ -128,11 +128,16 @@ class ZarrReader(BaseReader):
         # adds half x/y resolution on each values
         # https://github.com/corteva/rioxarray/issues/645#issuecomment-1461070634
         xres, yres = map(abs, self.dataset.rio.resolution())
+        # the half-cell allowance needs some slack: coordinate arrays built with
+        # `numpy.arange` carry a float residue (up to ~1e-9 degrees for a 0.001
+        # degree grid) which is enough to miss the allowance and reject a valid
+        # global dataset. A thousandth of a cell is far below any real overshoot.
+        xeps, yeps = xres / 1e3, yres / 1e3
         if self.crs == WGS84_CRS and (
-            self.bounds[0] + xres / 2 < -180
-            or self.bounds[1] + yres / 2 < -90
-            or self.bounds[2] - xres / 2 > 180
-            or self.bounds[3] - yres / 2 > 90
+            self.bounds[0] + xres / 2 < -180 - xeps
+            or self.bounds[1] + yres / 2 < -90 - yeps
+            or self.bounds[2] - xres / 2 > 180 + xeps
+            or self.bounds[3] - yres / 2 > 90 + yeps
         ):
             raise InvalidGeographicBounds(
                 f"Invalid geographic bounds: {self.bounds}. Must be within (-180, -90, 180, 90)."
