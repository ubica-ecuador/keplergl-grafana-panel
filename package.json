{
  "name": "ubica-keplergl-panel",
  "version": "1.0.0",
  "description": "Spatio-temporal maps for Grafana dashboards — trajectories, origin-destination flows and velocity fields from any data source. Runs kepler.gl inside the panel.",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "server:sources": "docker compose up --build grafana-sources sources-data",
    "verify:spike": "node scripts/verify-spike.mjs http://localhost:3000 spike-default-csp.png",
    "verify:spike:csp": "node scripts/verify-spike.mjs http://localhost:3001 spike-strict-csp.png",
    "verify:sources": "node scripts/verify-sources.mjs http://localhost:3002 sources-verify.png",
    "docs:dev": "npm --prefix docs/site run dev",
    "docs:build": "npm --prefix docs/site run build",
    "docs:preview": "npm --prefix docs/site run preview",
    "docs:linkcheck": "npm --prefix docs/site run linkcheck",
    "docs:shots": "node scripts/capture-docs.mjs",
    "sign": "sign-plugin"
  },
  "author": "Ubica",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/plugin-e2e": "^3.11.1",
    "@grafana/sign-plugin": "^3.2.2",
    "@grafana/tsconfig": "^2.0.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.38.0",
    "assert": "^2.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "playwright": "^1.61.1",
    "prettier": "^3.6.0",
    "process": "^0.11.10",
    "react-intl": "^7.0.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^17.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.3",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^6.0.1",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.10",
    "@deck.gl/geo-layers": "9.3.10",
    "@deck.gl/layers": "9.3.10",
    "@grafana/data": "12.0.0",
    "@grafana/runtime": "12.0.0",
    "@grafana/ui": "12.0.0",
    "@loaders.gl/wms": "4.4.1",
    "kepler.gl": "3.3.0-alpha.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-palm": "^3.3.11",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "styled-components": "6.4.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "d3-color": "^3.1.0"
  },
  "packageManager": "npm@10.5.0"
}
