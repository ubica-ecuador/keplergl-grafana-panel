      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- La distribución de minutos del ráster elegido dentro de la zona consultada,\n-- medida por TiTiler: el área dibujada en el mapa, o todo el ráster.\nWITH zona AS (\n  SELECT nullif($area, '') IS NOT NULL AS dibujada,\n         ST_GeomFromText(coalesce(nullif($area, ''), 'POLYGON((-79.0865 -2.9574, -78.8805 -2.9574, -78.8805 -2.8073, -79.0865 -2.8073, -79.0865 -2.9574))')) AS g\n), s AS (\n  SELECT dibujada, g, http_post('http://titiler/cog/statistics?url=http://sources-data/accesibilidad-cuenca/' || $categoria || '.tif&histogram_bins=0,15,30,60,120,121', MAP {}, json_object('type', 'Feature', 'properties', json_object(), 'geometry', ST_AsGeoJSON(zona.g)::JSON)) AS r FROM zona\n), st AS (\n  SELECT dibujada, g, CASE WHEN (r->>'status') = '200' THEN (r->>'body')::JSON -> 'properties' -> 'statistics' -> 'b1'\n            ELSE error('TiTiler no pudo medir la zona (' || coalesce(r->>'status', '?') || '): ' || coalesce(nullif(r->>'body', ''), r->>'reason', '')) END AS b FROM s\n), h AS (\n  SELECT dibujada, ST_Area_Spheroid(ST_FlipCoordinates(g)) / 1e6 AS km2,\n         (b->>'median')::DOUBLE AS mediana, [(b->'histogram'->0->>i)::DOUBLE FOR i IN range(5)] AS c\n  FROM st\n)\nSELECT CASE WHEN dibujada THEN 'Área dibujada' ELSE 'Todo el ráster' END AS \"Zona\",\n       km2 AS \"Superficie\",\n       mediana AS \"Mediana\",\n       100 * c[1] / nullif(list_sum(c), 0) AS \"≤15 min\",\n       100 * c[2] / nullif(list_sum(c), 0) AS \"15–30 min\",\n       100 * c[3] / nullif(list_sum(c), 0) AS \"30–60 min\",\n       100 * c[4] / nullif(list_sum(c), 0) AS \"60–120 min\",\n       100 * c[5] / nullif(list_sum(c), 0) AS \"Sin acceso (120)\"\nFROM h",
          "refId": "A"
        }
      ],
      "title": "${categoria:text}",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Zona",
                "Superficie",
                "Mediana"
              ]
            }
          }
        }
      ],
      "type": "stat"
    },
