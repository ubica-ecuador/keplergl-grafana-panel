      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Un COG por categoría, servido junto al tablero. TiTiler lo lee dentro de la red\n-- de Docker y el navegador solo recibe teselas. `$categoria` va sin comillas:\n-- este datasource ya las pone.\nSELECT 'http://sources-data/accesibilidad-cuenca/' || $categoria || '.tif' AS raster_url",
          "refId": "A"
        }
      ],
      "options": {
        "basemap": "auto",
