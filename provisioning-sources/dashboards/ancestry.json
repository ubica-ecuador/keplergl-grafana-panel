    {
      "id": 3,
      "type": "ubica-keplergl-panel",
      "title": "Ascendencia mayoritaria por census tract",
      "description": "Polígonos servidos como GeoJSON desde GeoParquet. El recorte usa las cuatro columnas de bounding box en vez de ST_Intersects: un BETWEEN sobre DOUBLE lo poda Parquet por estadísticas de row-group, mientras que la intersección obligaría a decodificar las 85k geometrías. Tope de 6.000 tracts por consulta, las más pobladas primero: a zoom metropolitano entran todas, a zoom nacional verás las ciudades y no el país entero.",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Polígonos de census tract coloreados por su ascendencia mayoritaria.\n-- El CAST a VARCHAR no es decorativo: ST_AsGeoJSON devuelve el tipo JSON de\n-- DuckDB y el driver Go del datasource no puede escanearlo a string. kepler\n-- tampoco renderiza WKB, así que la geometría tiene que llegar como GeoJSON.\nSELECT t.geoid, t.name, t.county, t.state, t.total_pop,\n       t.top1_ancestry, t.top1_color_group, round(100 * t.top1_pct, 1) AS top1_porcentaje,\n       t.top2_ancestry, t.top3_ancestry,\n       CAST(ST_AsGeoJSON(g.geometry) AS VARCHAR) AS geojson\nFROM read_parquet('/testdata/ancestry/tracts-geom.parquet') g\nJOIN read_parquet('/testdata/ancestry/tracts.parquet') t USING (geoid)\nWHERE g.maxx > ${west:raw} AND g.minx < ${east:raw} AND g.maxy > ${south:raw} AND g.miny < ${north:raw}\nORDER BY t.total_pop DESC\nLIMIT 6000",
          "refId": "A"
        }
      ],
