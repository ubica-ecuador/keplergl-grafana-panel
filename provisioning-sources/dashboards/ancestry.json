    {
      "id": 4,
      "type": "ubica-keplergl-panel",
      "title": "Coroplético · $grupo",
      "description": "Escala secuencial de un solo tono sobre el porcentaje del grupo elegido en la variable. Cubre los 158 grupos, incluidos los que en el mosaico caen dentro de «Otros grupos». Mismo tope de 6.000 tracts que el panel de la izquierda.",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Un solo grupo, escala secuencial. Cubre los 158 grupos del fixture,\n-- no solo los siete que tienen color propio en el mosaico.\nSELECT t.geoid, t.name, t.county, t.state, a.ancestry, a.estimate AS personas,\n       round(100 * a.pct, 2) AS pct,\n       CAST(ST_AsGeoJSON(g.geometry) AS VARCHAR) AS geojson\nFROM read_parquet('/testdata/ancestry/tract-ancestry.parquet') a\nJOIN read_parquet('/testdata/ancestry/tracts-geom.parquet') g USING (geoid)\nJOIN read_parquet('/testdata/ancestry/tracts.parquet') t USING (geoid)\nWHERE a.ancestry = '${grupo:raw}' AND g.maxx > ${west:raw} AND g.minx < ${east:raw} AND g.maxy > ${south:raw} AND g.miny < ${north:raw}\nORDER BY t.total_pop DESC\nLIMIT 6000",
          "refId": "A"
        }
      ],
