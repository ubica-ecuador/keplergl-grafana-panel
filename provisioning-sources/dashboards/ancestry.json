    {
      "id": 6,
      "type": "barchart",
      "title": "Los 15 grupos más numerosos del encuadre",
      "description": "Lo que hay dentro de «Otros grupos». Agrega en SQL, a diferencia de los mapas.",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- A diferencia de los mapas, los paneles que agregan sí recortan en SQL. Aquí se\n-- usan los cuatro buckets siempre: agregar 1,35 millones de filas en DuckDB es\n-- barato, y devuelve quince.\nSELECT d.ancestry AS \"Grupo\", count(*) * 250 AS \"Personas (aprox.)\"\nFROM read_parquet('/testdata/ancestry/dots.parquet') d\nWHERE d.longitude BETWEEN ${west:raw} AND ${east:raw}\n  AND d.latitude  BETWEEN ${south:raw} AND ${north:raw}\n  AND d.ancestry <> 'Sin ascendencia reportada'\nGROUP BY 1 ORDER BY 2 DESC LIMIT 15",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "axisPlacement": "auto",
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Census tracts del encuadre",
      "description": "Los tres grupos principales de cada tract, que es lo que el color de un mapa no puede mostrar a la vez.",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "gridPos": {
        "h": 11,
        "w": 16,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT t.name AS \"Tract\", t.county AS \"Condado\", t.state_abbr AS \"Est.\",\n       t.total_pop AS \"Población\",\n       t.top1_ancestry AS \"1º\", round(100 * t.top1_pct, 1) AS \"1º %\",\n       t.top2_ancestry AS \"2º\", round(100 * t.top2_pct, 1) AS \"2º %\",\n       t.top3_ancestry AS \"3º\", round(100 * t.top3_pct, 1) AS \"3º %\"\nFROM read_parquet('/testdata/ancestry/tracts.parquet') t\nJOIN read_parquet('/testdata/ancestry/tracts-geom.parquet') g USING (geoid)\nWHERE g.maxx > ${west:raw} AND g.minx < ${east:raw} AND g.maxy > ${south:raw} AND g.miny < ${north:raw}\nORDER BY t.total_pop DESC LIMIT 500",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Población",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Población"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Resumen del encuadre",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "gridPos": {
        "h": 11,
        "w": 8,
        "x": 16,
        "y": 50
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- El CAST importa. sum() sobre un BIGINT devuelve HUGEINT en DuckDB, y el\n-- driver Go del datasource entrega HUGEINT como string: el panel stat recibe\n-- entonces un campo de texto, no puede reducirlo y se queda en blanco. Es el\n-- mismo tipo de tropiezo que el CAST de ST_AsGeoJSON en los paneles de mapa.\nSELECT sum(t.total_pop)::BIGINT AS \"Población en el encuadre\",\n       count(*) AS \"Census tracts\",\n       count(DISTINCT t.top1_ancestry) AS \"Grupos mayoritarios distintos\"\nFROM read_parquet('/testdata/ancestry/tracts.parquet') t\nJOIN read_parquet('/testdata/ancestry/tracts-geom.parquet') g USING (geoid)\nWHERE g.maxx > ${west:raw} AND g.minx < ${east:raw} AND g.maxy > ${south:raw} AND g.miny < ${north:raw}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    }
  ]
}
