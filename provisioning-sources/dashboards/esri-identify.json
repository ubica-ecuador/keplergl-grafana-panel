{
  "uid": "esri-identify",
  "title": "ArcGIS Image Service — pincha y pregunta",
  "description": "La coordenada del clic va a variables y una consulta normal le pregunta al servicio qué clase hay ahí. Sin código de plugin.",
  "tags": [
    "arcgis",
    "kepler",
    "raster"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "text": "2023",
          "value": "2023"
        },
        "label": "Año",
        "name": "anio",
        "type": "custom",
        "query": "2017, 2018, 2019, 2020, 2021, 2022, 2023",
        "options": [],
        "hide": 0
      },
      {
        "current": {
          "text": "-1.5",
          "value": "-1.5"
        },
        "label": "lat",
        "name": "lat",
        "type": "textbox",
        "query": "-1.5",
        "options": [],
        "hide": 0
      },
      {
        "current": {
          "text": "-76.5",
          "value": "-76.5"
        },
        "label": "lng",
        "name": "lng",
        "type": "textbox",
        "query": "-76.5",
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "ubica-keplergl-panel",
      "title": "Pincha en el mapa",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "gridPos": {
        "h": 17,
        "w": 17,
        "x": 0,
        "y": 0
      },
      "options": {
        "showSidePanel": false,
        "timeSync": "off",
        "mapConfig": {
          "config": {
            "mapState": {
              "bearing": 0,
              "dragRotate": false,
              "latitude": -1.6,
              "longitude": -78.5,
              "pitch": 0,
              "zoom": 6.0
            },
            "visState": {
              "filters": [],
              "layers": [],
              "layerOrder": [],
              "layerBlending": "normal",
              "interactionConfig": {
                "tooltip": {
                  "enabled": false
                },
                "brush": {
                  "enabled": false,
                  "size": 0.5
                },
                "coordinate": {
                  "enabled": true
                },
                "geocoder": {
                  "enabled": false
                }
              }
            }
          },
          "datasets": [],
          "version": "v1"
        },
        "variableMappings": [
          {
            "source": "coordinate",
            "field": "",
            "variable": "lat",
            "variableTo": "lng"
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawSql": "SELECT\n  'https://ic.imagery1.arcgis.com/arcgis/rest/services/Sentinel2_10m_LandCover/ImageServer' AS esri_url,\n  '{\"mosaicMethod\":\"esriMosaicAttribute\",\"where\":\"Year=' || CAST($anio AS VARCHAR) || '\"}' AS mosaic_rule\n"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cobertura en el punto",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "gridPos": {
        "h": 17,
        "w": 7,
        "x": 17,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "url": "https://ic.imagery1.arcgis.com/arcgis/rest/services/Sentinel2_10m_LandCover/ImageServer/identify",
          "root_selector": "",
          "columns": [
            {
              "selector": "value",
              "text": "clase",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "geometry",
                "value": "{\"x\":${lng:raw},\"y\":${lat:raw},\"spatialReference\":{\"wkid\":4326}}"
              },
              {
                "key": "geometryType",
                "value": "esriGeometryPoint"
              },
              {
                "key": "mosaicRule",
                "value": "{\"mosaicMethod\":\"esriMosaicAttribute\",\"where\":\"Year=${anio:raw}\"}"
              },
              {
                "key": "returnCatalogItems",
                "value": "false"
              },
              {
                "key": "f",
                "value": "json"
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^clase$/",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
