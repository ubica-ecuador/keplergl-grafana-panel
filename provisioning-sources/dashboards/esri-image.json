        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawSql": "-- Un servicio, no un fichero. No hace falta servidor de teselas propio ni\n-- firma: el ImageServer es un mosaic dataset --catalogo, regla de eleccion y\n-- piramide sobre el conjunto-- y responde para cualquier extension y zoom.\n--\n-- La regla de mosaico es la que elige el ano, y es la misma que este banco ya\n-- le manda a computeHistograms para las cifras.\nSELECT\n  'https://ic.imagery1.arcgis.com/arcgis/rest/services/Sentinel2_10m_LandCover/ImageServer' AS esri_url,\n  '{\"mosaicMethod\":\"esriMosaicAttribute\",\"where\":\"Year=' || CAST($anio AS VARCHAR) || '\"}' AS mosaic_rule\n"
        }
      ]
    }
  ]
