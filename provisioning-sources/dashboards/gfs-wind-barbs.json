          "uid": "duckdb"
        },
        "definition": "",
        "description": "Which forecast step both maps draw. It is the only clock here: a velocity field holds one instant.",
        "includeAll": false,
        "label": "Forecast hour",
        "name": "hour",
        "options": [],
        "query": "-- The forecast steps the server itself holds, not dates written by hand: the\n-- archive is three-hourly, and `last-64` to `last` is the newest run's week of\n-- forecast plus a little analysis behind it. The list moves on with every run.\n--\n-- Read as VARCHAR and handed back untouched: what ERDDAP wrote is exactly what\n-- ERDDAP accepts back. The cast is only for the label.\n--\n-- OJO: in a VARIABLE query this datasource quotes nothing by itself, unlike in a\n-- panel query.\nSELECT strftime(t::TIMESTAMP, '%a %d %b %H:%M UTC') AS __text,\n       t AS __value\nFROM read_csv('https://pae-paha.pacioos.hawaii.edu/erddap/griddap/ncep_global.csv0?time%5Blast-64:1:last%5D',\n              header = false, columns = {'t': 'VARCHAR'})\n-- Grafana takes the FIRST option by default, so the cut opens the dashboard on\n-- the step nearest to now: steps are three hours apart, so nothing older than\n-- ninety minutes can be the nearest.\nWHERE t::TIMESTAMP >= (now() AT TIME ZONE 'UTC') - INTERVAL '90 minutes'\nORDER BY t\n",
        "refresh": 1,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now+7d"
