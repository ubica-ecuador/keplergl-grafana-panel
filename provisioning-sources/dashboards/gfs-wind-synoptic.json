      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- The synoptic chart's own query: the same 48 hours and the same one-degree\n-- lattice as the arrows map above, with sea-level pressure and rain beside u and v.\n--\n-- Its own and not the arrows map's, on purpose. ERDDAP's cost grows with every variable\n-- asked for: two take the map above about 7 s, four took 18 to 25 s. Asked for\n-- here, the wait is paid only by whoever scrolls this far, since Grafana does\n-- not query a panel until it comes into view. The map still walks with the\n-- other one: the time is shared between maps in the browser, not through a query.\n--\n-- The window, the one-step lead and `format`'s {0} and {1} are explained in the\n-- arrows map's query above.\nSELECT column0         AS time,\n       column1         AS latitude,\n       column2 - 360   AS longitude,\n       column3         AS u,\n       column4         AS v,\n       column5 / 100   AS pressure_hpa,  -- Pa\n       -- The same pressure a hundred thousand times over, for the isobars only:\n       -- the layer takes its slope per metre, so this one's reads in hPa per\n       -- 100 km, the unit its legend then shows.\n       column5 * 1000  AS isobar_field,\n       column6 * 3600  AS rain_mm_h,     -- kg m-2 s-1, a millimetre of water per square metre\n       -- What the dots are sized by. Capped, so the rare cloudburst does not set\n       -- the scale and shrink ordinary rain to specks.\n       least(column6 * 3600, 10) AS rain_mm_h_capped\nFROM read_csv(\n  format('https://pae-paha.pacioos.hawaii.edu/erddap/griddap/ncep_global.csv0?ugrd10m%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D,vgrd10m%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D,prmslmsl%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D,pratesfc%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D',\n    strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') - INTERVAL 90 MINUTE),\n             '%Y-%m-%dT%H:%M:%SZ'),\n    strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') - INTERVAL 90 MINUTE) + INTERVAL 48 HOUR,\n             '%Y-%m-%dT%H:%M:%SZ')),\n  header = false,\n  columns = {'column0': 'TIMESTAMP', 'column1': 'DOUBLE', 'column2': 'DOUBLE', 'column3': 'DOUBLE',\n             'column4': 'DOUBLE', 'column5': 'DOUBLE', 'column6': 'DOUBLE'},\n  nullstr = 'NaN')\nWHERE column3 IS NOT NULL AND column4 IS NOT NULL AND column5 IS NOT NULL\n",
          "refId": "A"
        }
      ],
      "title": "Pressure and wind: the synoptic chart",
      "type": "ubica-keplergl-panel",
      "description": "Wind streamlines over the sea-level pressure field's contours, which are traced as still lines and coloured by the gradient in hPa per 100 km: where they crowd, the wind is strong. Near the surface, friction turns the wind a little toward the low, and near the equator, where the Coriolis force fades, it cuts across the isobars. They stand still because, drawn moving, they would run against the wind south of the equator. Along the Andes they crowd for want of a sea: the pressure there is carried down to a sea level kilometres below the ground, so read that bright band as the mountains, not the weather."
    },
    {
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "id": 5,
      "title": "Airports: forecast against observation",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- The latest METAR from every airport in the maps' box, set against the GFS\n-- cell nearest to it, at the forecast step nearest to its own observation.\n--\n-- aviationweather.gov answers with one row per airport, its latest report. The\n-- direction is a number or the string \"VRB\" for a variable wind, so it arrives\n-- as JSON and is read as text first.\n--\n-- The GFS side is the full half-degree grid, not the maps' one-degree lattice,\n-- for the two steps around the observations: METARs are at most about an hour\n-- old, so the step at or before now - 3 h and the one nearest to now bracket\n-- them all.\nWITH metar AS (\n  SELECT icaoId                                       AS icao,\n         name,\n         lat,\n         lon,\n         to_timestamp(obsTime) AT TIME ZONE 'UTC'      AS observed,\n         TRY_CAST(wdir::VARCHAR AS INTEGER)           AS obs_dir,  -- NULL for \"VRB\"\n         wspd                                         AS obs_kn\n  FROM read_json('https://aviationweather.gov/api/data/metar?bbox=-40,-100,12,-50&format=json')\n),\ngfs AS (\n  SELECT column0                                                AS step,\n         column1                                                AS lat,\n         column2 - 360                                          AS lon,\n         sqrt(column3 * column3 + column4 * column4) * 1.943844 AS kn,  -- m/s to knots\n         -- Where the wind comes FROM, as a METAR reports it.\n         (degrees(atan2(-column3, -column4)) + 360) % 360       AS dir\n  FROM read_csv(\n    format('https://pae-paha.pacioos.hawaii.edu/erddap/griddap/ncep_global.csv0?ugrd10m%5B({0}):1:({1})%5D%5B(-40.0):1:(12.0)%5D%5B(260.0):1:(310.0)%5D,vgrd10m%5B({0}):1:({1})%5D%5B(-40.0):1:(12.0)%5D%5B(260.0):1:(310.0)%5D',\n      strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') - INTERVAL 3 HOUR), '%Y-%m-%dT%H:%M:%SZ'),\n      strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') + INTERVAL 90 MINUTE), '%Y-%m-%dT%H:%M:%SZ')),\n    header = false,\n    columns = {'column0': 'TIMESTAMP', 'column1': 'DOUBLE', 'column2': 'DOUBLE',\n               'column3': 'DOUBLE', 'column4': 'DOUBLE'},\n    nullstr = 'NaN')\n  WHERE column3 IS NOT NULL AND column4 IS NOT NULL\n)\nSELECT icao                          AS \"Airport\",\n       name                          AS \"Name\",\n       round(kn - obs_kn, 1)         AS \"Speed error kn\",\n       -- The short way round the compass. Left empty for a variable or a light\n       -- wind: under 3 kn the vane says little, and those would swamp the mean.\n       CASE WHEN obs_dir IS NULL OR obs_kn < 3 THEN NULL\n            ELSE round(abs(((obs_dir - dir + 540) % 360) - 180)) END AS \"Direction error °\",\n       obs_dir                       AS \"Observed from\",\n       obs_kn                        AS \"Observed kn\",\n       round(dir)                    AS \"GFS from\",\n       round(kn, 1)                  AS \"GFS kn\",\n       observed                      AS \"Observed\"\nFROM metar\nJOIN gfs ON gfs.lat = round(metar.lat * 2) / 2 AND gfs.lon = round(metar.lon * 2) / 2\nQUALIFY row_number() OVER (PARTITION BY icao ORDER BY abs(epoch(step) - epoch(observed))) = 1\nORDER BY abs(kn - obs_kn) DESC\n",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
