      "pluginVersion": "1.0.0",
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- The synoptic chart's own query: the same 48 hours and the same one-degree\n-- lattice as the arrows map above, with sea-level pressure and rain beside u and v.\n--\n-- Its own and not the arrows map's, on purpose. ERDDAP's cost grows with every variable\n-- asked for: two take the map above about 7 s, four took 18 to 25 s. Asked for\n-- here, the wait is paid only by whoever scrolls this far, since Grafana does\n-- not query a panel until it comes into view. The map still walks with the\n-- other one: the time is shared between maps in the browser, not through a query.\n--\n-- The window, the one-step lead and `format`'s {0} and {1} are explained in the\n-- arrows map's query above.\nSELECT column0         AS time,\n       column1         AS latitude,\n       column2 - 360   AS longitude,\n       column3         AS u,\n       column4         AS v,\n       column5 / 100   AS pressure_hpa,  -- Pa\n       -- The same pressure a hundred thousand times over, for the isobars only:\n       -- the layer takes its slope per metre, so this one's reads in hPa per\n       -- 100 km, the unit its legend then shows.\n       column5 * 1000  AS isobar_field,\n       column6 * 3600  AS rain_mm_h,     -- kg m-2 s-1, a millimetre of water per square metre\n       -- What the dots are sized by. Capped, so the rare cloudburst does not set\n       -- the scale and shrink ordinary rain to specks.\n       least(column6 * 3600, 10) AS rain_mm_h_capped\nFROM read_csv(\n  format('https://pae-paha.pacioos.hawaii.edu/erddap/griddap/ncep_global.csv0?ugrd10m%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D,vgrd10m%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D,prmslmsl%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D,pratesfc%5B({0}):1:({1})%5D%5B(-40.0):2:(12.0)%5D%5B(260.0):2:(310.0)%5D',\n    strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') - INTERVAL 90 MINUTE),\n             '%Y-%m-%dT%H:%M:%SZ'),\n    strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') - INTERVAL 90 MINUTE) + INTERVAL 48 HOUR,\n             '%Y-%m-%dT%H:%M:%SZ')),\n  header = false,\n  columns = {'column0': 'TIMESTAMP', 'column1': 'DOUBLE', 'column2': 'DOUBLE', 'column3': 'DOUBLE',\n             'column4': 'DOUBLE', 'column5': 'DOUBLE', 'column6': 'DOUBLE'},\n  nullstr = 'NaN')\nWHERE column3 IS NOT NULL AND column4 IS NOT NULL AND column5 IS NOT NULL\n",
          "refId": "A"
        }
      ],
      "title": "Pressure and wind: the synoptic chart",
      "type": "ubica-keplergl-panel"
    },
    {
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "description": "The latest METAR from each airport in the maps' box against the GFS half-degree cell nearest to it, at the forecast step nearest to the observation. Sorted by the size of the speed error. It stays on the present whatever the map's bar says: an observation exists only for now. A half-degree cell is not a mountain airport: at Quito part of the error is the grid's.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false,
            "width": 100
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Speed error kn"
            },
            "properties": [
              {
                "id": "min",
                "value": -15
              },
              {
                "id": "max",
                "value": 15
              },
              {
