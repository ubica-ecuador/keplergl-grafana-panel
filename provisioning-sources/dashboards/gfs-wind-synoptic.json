      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- The latest METAR from every airport in the map's box, set against the GFS\n-- cell nearest to it, at the forecast step nearest to its own observation.\n--\n-- aviationweather.gov answers with one row per airport, its latest report. The\n-- direction is a number or the string \"VRB\" for a variable wind, so it arrives\n-- as JSON and is read as text first.\n--\n-- The GFS side is the full half-degree grid, not the maps' one-degree lattice,\n-- for the two steps around the observations: METARs are at most about an hour\n-- old, so the step at or before now - 3 h and the one nearest to now bracket\n-- them all.\nWITH metar AS (\n  SELECT icaoId                                       AS icao,\n         name,\n         lat,\n         lon,\n         to_timestamp(obsTime) AT TIME ZONE 'UTC'      AS observed,\n         TRY_CAST(wdir::VARCHAR AS INTEGER)           AS obs_dir,  -- NULL for \"VRB\"\n         wspd                                         AS obs_kn\n  FROM read_json('https://aviationweather.gov/api/data/metar?bbox=-40,-100,12,-50&format=json')\n),\ngfs AS (\n  SELECT column0                                                AS step,\n         column1                                                AS lat,\n         column2 - 360                                          AS lon,\n         sqrt(column3 * column3 + column4 * column4) * 1.943844 AS kn,  -- m/s to knots\n         -- Where the wind comes FROM, as a METAR reports it.\n         (degrees(atan2(-column3, -column4)) + 360) % 360       AS dir\n  FROM read_csv(\n    format('https://pae-paha.pacioos.hawaii.edu/erddap/griddap/ncep_global.csv0?ugrd10m%5B({0}):1:({1})%5D%5B(-40.0):1:(12.0)%5D%5B(260.0):1:(310.0)%5D,vgrd10m%5B({0}):1:({1})%5D%5B(-40.0):1:(12.0)%5D%5B(260.0):1:(310.0)%5D',\n      strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') - INTERVAL 3 HOUR), '%Y-%m-%dT%H:%M:%SZ'),\n      strftime(time_bucket(INTERVAL 3 HOUR, (now() AT TIME ZONE 'UTC') + INTERVAL 90 MINUTE), '%Y-%m-%dT%H:%M:%SZ')),\n    header = false,\n    columns = {'column0': 'TIMESTAMP', 'column1': 'DOUBLE', 'column2': 'DOUBLE',\n               'column3': 'DOUBLE', 'column4': 'DOUBLE'},\n    nullstr = 'NaN')\n  WHERE column3 IS NOT NULL AND column4 IS NOT NULL\n)\nSELECT icao                          AS \"Airport\",\n       name                          AS \"Name\",\n       round(kn - obs_kn, 1)         AS \"Speed error kn\",\n       -- The short way round the compass. Left empty for a variable or a light\n       -- wind: under 3 kn the vane says little, and those would swamp the mean.\n       CASE WHEN obs_dir IS NULL OR obs_kn < 3 THEN NULL\n            ELSE round(abs(((obs_dir - dir + 540) % 360) - 180)) END AS \"Direction error °\",\n       obs_dir                       AS \"Observed from\",\n       obs_kn                        AS \"Observed kn\",\n       round(dir)                    AS \"GFS from\",\n       round(kn, 1)                  AS \"GFS kn\",\n       observed                      AS \"Observed\"\nFROM metar\nJOIN gfs ON gfs.lat = round(metar.lat * 2) / 2 AND gfs.lon = round(metar.lon * 2) / 2\nQUALIFY row_number() OVER (PARTITION BY icao ORDER BY abs(epoch(step) - epoch(observed))) = 1\nORDER BY abs(kn - obs_kn) DESC\n",
          "refId": "A"
        }
      ],
      "title": "Airports: forecast against observation",
      "type": "table"
    }
