    {
      "type": "ubica-keplergl-panel",
      "id": 4,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "title": "Troncos principales en vivo — HydroSHEDS v2, Strahler ≥ 10, sin descargar nada",
      "description": "16.715 tramos leídos del feature service de Esri Living Atlas en cada carga: 7 MB en dos páginas. Solo Strahler ≥ 10 — el umbral está fijo porque el número de páginas tiene que coincidir con el de tramos, ver el comentario en la consulta. Es una red de troncos, no la red completa: la densa es la de los mapas de arriba, que sale de Parquet local.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://services5.arcgis.com/7weheFjxuNkGGiZi/arcgis/rest/services/HydroSHEDS_v2_River_Streamlines_view/FeatureServer/0/query?resultOffset=${__pagination.resultOffset}&resultRecordCount=${__pagination.resultRecordCount}",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "where",
                "value": "ORD_STRAH >= 10"
              },
              {
                "key": "outFields",
                "value": "STRM_ID,STRM_DN,ORD_STRAH,UPLAND_SKM,LENGTH_KM,UPSTREAM_KM,MAIN_BAS"
              },
              {
                "key": "orderByFields",
                "value": "OBJECTID"
              },
              {
                "key": "returnGeometry",
                "value": "true"
              },
              {
                "key": "outSR",
                "value": "4326"
              },
              {
                "key": "maxAllowableOffset",
                "value": "$detalle"
