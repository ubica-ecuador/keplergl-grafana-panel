      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Mareografos del INOCAR: la red nacional, al minuto, ultimas 24 h.\n--\n-- El catalogo de estaciones da nombre y posicion; cada serie llega como\n-- {inicio: ms, datos_alturas: [...]} SIN horas: el punto i es `inicio` + i\n-- minutos. `inicio` es UTC. Puna (id 10) publica serie pero no esta en el\n-- catalogo, asi que no tiene posicion y queda fuera.\n--\n-- Cada mareografo mide contra su propio cero (Rio Guayas ronda 4 m, Puerto Atun\n-- 1,3 m): sobre_bajamar -- la altura menos el MINIMO de las 24 h de ese puerto --\n-- quita ese cero propio y es lo que se puede comparar entre puertos. A diferencia\n-- de una anomalia (altura menos la MEDIA), sobre_bajamar nunca es negativo, que es\n-- lo que necesita el heatmap de kepler: su heatColor() trata cualquier valor <= 0\n-- como si no hubiera dato y no lo pinta.\nWITH estaciones AS (\n  SELECT f.properties.id_estacion::INTEGER AS id,\n         f.properties.estacion           AS estacion,\n         f.properties.latitud::DOUBLE    AS latitude,\n         f.properties.longitud::DOUBLE   AS longitude\n  FROM (SELECT unnest(features) AS f\n        FROM read_json('https://www.inocar.mil.ec/mareas/estaciones_monitoreo.php', format = 'auto'))\n),\nseries AS (\n  SELECT regexp_extract(filename, 'id_est=([0-9]+)', 1)::INTEGER AS id,\n         inicio::BIGINT AS inicio,\n         datos_alturas\n  FROM read_json([\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=1',\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=5',\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=7',\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=8',\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=9',\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=11',\n      'https://www.inocar.mil.ec/mareas/grasp/mareas_auto_data_tiempo.php?id_est=12'\n    ], format = 'auto', filename = true)\n),\npuntos AS (\n  SELECT s.id,\n         to_timestamp(s.inicio / 1000) + to_minutes(i - 1) AS time,\n         s.datos_alturas[i]::DOUBLE AS altura\n  FROM series s, range(1, len(s.datos_alturas) + 1) AS r(i)\n),\n-- El tramo de 3 h (en hora de Ecuador) de la lectura mas reciente de toda la red.\nultimo AS (\n  SELECT time_bucket(INTERVAL 3 HOUR, max(time) AT TIME ZONE 'America/Guayaquil') AS tramo\n  FROM puntos\n  WHERE altura IS NOT NULL\n)\n-- Ordenado por hora: en cada puerto el punto que queda ENCIMA (el que se ve y el\n-- que coge el tooltip) es la lectura mas reciente.\nSELECT e.estacion,\n       e.latitude,\n       e.longitude,\n       p.time,\n       p.altura,\n       round(p.altura - min(p.altura) OVER (PARTITION BY p.id), 3) AS sobre_bajamar,\n       -- Tramo de 3 horas en hora de Ecuador, como texto que ordena\n       -- cronologicamente (ano primero, relleno de ceros): agrupa el heatmap\n       -- fijado por bloques de 3 h en vez de una curva por puerto, que kepler no\n       -- sabe dibujar. El heatmap guarda como mucho 10 columnas -- las 10 con mas\n       -- filas -- y cada puerto trae su propio `inicio` (Puerto Atun va unas 5 h\n       -- por detras), asi que solo llevan tramo los 10 ultimos, contados desde la\n       -- lectura mas reciente: el resto queda en NULL, que kepler no agrupa, y el\n       -- tramo en curso nunca se cae. Doce caracteres como mucho: kepler recorta\n       -- ahi la cabecera.\n       CASE WHEN p.time AT TIME ZONE 'America/Guayaquil' >= u.tramo - INTERVAL 27 HOUR\n            THEN strftime(time_bucket(INTERVAL 3 HOUR, p.time AT TIME ZONE 'America/Guayaquil'), '%y-%m-%d %Hh')\n       END AS tramo\nFROM puntos p\nJOIN estaciones e USING (id)\nCROSS JOIN ultimo u\nWHERE p.altura IS NOT NULL\nORDER BY e.estacion, p.time\n",
          "refId": "A"
        }
      ],
      "title": "Mareógrafos — altura sobre la bajamar",
      "type": "ubica-keplergl-panel"
    },
    {
      "gridPos": {
