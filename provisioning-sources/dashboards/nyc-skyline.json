          "rawSql": "SELECT\n  era,\n  count(*) AS buildings,\n  round(avg(height_roof), 1) AS avg_height_ft\nFROM read_parquet('http://sources-data/nyc-buildings.parquet')\nWHERE height_roof >= CAST($minHeight AS DOUBLE)\n    AND era IN (${era:singlequote})\nGROUP BY era\nORDER BY min(coalesce(construction_year, 9999))",
