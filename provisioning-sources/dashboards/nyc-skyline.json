    {
      "id": 3,
      "type": "stat",
      "title": "Within ${radius:text} of a station",
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 17,
        "y": 9
      },
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "rawSql": "WITH b AS (\n  SELECT bin, height_roof,\n         ST_Transform(ST_Centroid(geometry), 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt,\n         ST_Area(ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true)) AS footprint_m2\n  FROM read_parquet('http://sources-data/nyc-buildings.parquet')\n  WHERE height_roof >= CAST($minHeight AS DOUBLE)\n    AND era IN (${era:singlequote})\n), s AS (\n  SELECT stop_name, daytime_routes, borough, ada,\n         ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt\n  FROM read_parquet('http://sources-data/nyc-subway-stations.parquet')\n)\n, tagged AS (\n  SELECT EXISTS (\n    SELECT 1 FROM s WHERE ST_DWithin(b.pt, s.pt, CAST($radius AS DOUBLE))\n  ) AS served\n  FROM b\n)\nSELECT\n  round(100.0 * count(*) FILTER (WHERE served) / nullif(count(*), 0), 1) AS \"Within reach\",\n  count(*) FILTER (WHERE served) AS \"Buildings served\",\n  count(*) AS \"Buildings shown\"\nFROM tagged",
          "format": 1
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0,
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Within reach"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Stations, by how much of the city they stand in",
      "description": "Buildings whose centre falls within $radius m of the station, and what they add up to.",
      "gridPos": {
        "h": 17,
        "w": 7,
        "x": 17,
        "y": 16
      },
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "duckdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "rawSql": "WITH b AS (\n  SELECT bin, height_roof,\n         ST_Transform(ST_Centroid(geometry), 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt,\n         ST_Area(ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true)) AS footprint_m2\n  FROM read_parquet('http://sources-data/nyc-buildings.parquet')\n  WHERE height_roof >= CAST($minHeight AS DOUBLE)\n    AND era IN (${era:singlequote})\n), s AS (\n  SELECT stop_name, daytime_routes, borough, ada,\n         ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt\n  FROM read_parquet('http://sources-data/nyc-subway-stations.parquet')\n)\nSELECT\n  s.stop_name AS \"Station\",\n  s.daytime_routes AS \"Routes\",\n  CASE s.borough WHEN 'M' THEN 'Manhattan' WHEN 'Bk' THEN 'Brooklyn'\n                 WHEN 'Bx' THEN 'Bronx'    WHEN 'Q'  THEN 'Queens'\n                 WHEN 'SI' THEN 'Staten Island' END AS \"Borough\",\n  CASE s.ada WHEN 1 THEN 'Full' WHEN 2 THEN 'Partial' ELSE 'None' END AS \"Step-free\",\n  count(b.bin) AS \"Buildings\",\n  round(max(b.height_roof)) AS \"Tallest (ft)\",\n  round(sum(b.footprint_m2)) AS \"Footprint (m2)\"\nFROM s LEFT JOIN b ON ST_DWithin(s.pt, b.pt, CAST($radius AS DOUBLE))\nGROUP BY 1, 2, 3, 4\nHAVING count(b.bin) > 0\nORDER BY 5 DESC",
          "format": 1
        }
      ],
