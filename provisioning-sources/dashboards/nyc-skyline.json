      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "rawSql": "SELECT\n  bin,\n  height_roof AS height_ft,\n  height_roof * 0.3048 AS height_m,\n  era,\n  construction_year,\n  -- The map's clock. Years before 1600 are the file's way of saying \"no idea\",\n  -- and a NULL keeps those buildings out of the animation rather than parking\n  -- them all on one impossible date.\n  CASE WHEN construction_year >= 1600\n       THEN make_timestamp(construction_year, 1, 1, 0, 0, 0) END AS time,\n  round(ST_Area(ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true))) AS footprint_m2,\n  ST_AsText(geometry) AS geom\nFROM read_parquet('http://sources-data/nyc-buildings.parquet')\nWHERE height_roof >= CAST($minHeight AS DOUBLE)\n    AND era IN (${era:singlequote})",
          "format": 1
        },
        {
          "refId": "B",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "rawSql": "SELECT service, service_name, ST_AsText(geometry) AS geom\nFROM read_parquet('http://sources-data/nyc-subway-lines.parquet')",
          "format": 1
        },
        {
          "refId": "C",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "rawSql": "SELECT\n  stop_name,\n  daytime_routes AS routes,\n  CASE ada WHEN 1 THEN 'Full' WHEN 2 THEN 'Partial' ELSE 'None' END AS step_free,\n  structure,\n  ST_Y(ST_Centroid(geometry)) AS latitude,\n  ST_X(ST_Centroid(geometry)) AS longitude\nFROM read_parquet('http://sources-data/nyc-subway-stations.parquet')",
          "format": 1
        }
      ],
