          "format": 1,
          "rawSql": "-- deck.gl's own trips example: 996 yellow-cab journeys in Lower Manhattan,\n-- read where it lives. Timestamps are seconds from an unnamed start; they are\n-- pinned here to midnight UTC on 1 January 2026, the zone kepler's clock\n-- shows, so it reads 00:00 to 00:41.\nWITH raw AS (\n  SELECT row_number() OVER () AS n, vendor, path, timestamps\n  FROM read_json('https://raw.githubusercontent.com/visgl/deck.gl-data/master/examples/trips/trips-v7.json',\n                 maximum_object_size = 100000000)\n  WHERE len(path) >= 2 AND len(path) = len(timestamps)\n),\npts AS (\n  SELECT n, vendor, timestamps[1] AS t_start, timestamps[-1] AS t_end,\n         unnest(path) AS p, unnest(timestamps) AS ts\n  FROM raw\n),\nlegs AS (\n  SELECT *,\n         -- Distance of each leg from the previous GPS point, for the per-trip total.\n         coalesce(ST_Distance_Sphere(ST_Point(p[2], p[1]),\n                  ST_Point(lag(p[2]) OVER w, lag(p[1]) OVER w)), 0) AS leg_m\n  FROM pts\n  WINDOW w AS (PARTITION BY n ORDER BY ts)\n)\nSELECT 'trip ' || n                                    AS trip_id,\n       'Vendor ' || vendor                             AS vendor,\n       to_timestamp(1767225600 + ts)                   AS time,\n       p[2]                                            AS latitude,\n       p[1]                                            AS longitude,\n       round(sum(leg_m) OVER (PARTITION BY n) / 1000, 2) AS trip_km,\n       round((t_end - t_start) / 60, 1)                AS trip_min\nFROM legs\nORDER BY n, ts",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawSql": "-- The footprints and heights that ship beside the trips in deck.gl's example.\n-- Each ring is a bare list of [lng, lat]; closed here so it reads as WKT.\nWITH raw AS (\n  SELECT height, CASE WHEN polygon[1] = polygon[-1] THEN polygon\n                      ELSE list_append(polygon, polygon[1]) END AS ring\n  FROM read_json('https://raw.githubusercontent.com/visgl/deck.gl-data/master/examples/trips/buildings.json',\n                 maximum_object_size = 100000000)\n  WHERE len(polygon) >= 3\n)\nSELECT height AS height_m,\n       'POLYGON((' || array_to_string(list_transform(ring, c -> c[1] || ' ' || c[2]), ', ') || '))' AS geom\nFROM raw",
          "refId": "B"
        }
      ],
      "title": "",
