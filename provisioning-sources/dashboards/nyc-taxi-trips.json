        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "duckdb"
          },
          "format": 1,
          "rawSql": "WITH raw AS (\n  SELECT row_number() OVER () AS n, path, timestamps, timestamps[1] AS t_start, timestamps[-1] AS t_end\n  FROM read_json('https://raw.githubusercontent.com/visgl/deck.gl-data/master/examples/trips/trips-v7.json',\n                 maximum_object_size = 100000000)\n  WHERE len(path) >= 2 AND len(path) = len(timestamps)\n),\npts AS (SELECT n, unnest(path) AS p, generate_subscripts(path, 1) AS i FROM raw),\nlegs AS (\n  SELECT coalesce(ST_Distance_Sphere(ST_Point(p[2], p[1]),\n                  ST_Point(lag(p[2]) OVER w, lag(p[1]) OVER w)), 0) AS leg_m\n  FROM pts WINDOW w AS (PARTITION BY n ORDER BY i)\n),\nclock AS (SELECT unnest(range(0, 2490, 10)) AS s)\nSELECT (SELECT count(*) FROM raw)                                   AS \"Trips\",\n       (SELECT sum(len(path))::BIGINT FROM raw)                     AS \"GPS points\",\n       (SELECT round(sum(leg_m) / 1000) FROM legs)                  AS \"Km driven\",\n       (SELECT round(median(t_end - t_start) / 60, 1) FROM raw)     AS \"Median trip, min\",\n       (SELECT max(c) FROM (SELECT count(*) AS c FROM clock JOIN raw ON s BETWEEN t_start AND t_end GROUP BY s)) AS \"Most taxis at once\"",
          "refId": "A"
        }
      ],
      "title": "",
      "type": "stat"
    },
