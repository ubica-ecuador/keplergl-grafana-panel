          "format": 1,
          "rawSql": "-- How many cabs are mid-trip at each moment, every ten seconds, by vendor.\nWITH raw AS (\n  SELECT vendor, timestamps[1] AS t_start, timestamps[-1] AS t_end\n  FROM read_json('https://raw.githubusercontent.com/visgl/deck.gl-data/master/examples/trips/trips-v7.json',\n                 maximum_object_size = 100000000)\n  WHERE len(path) >= 2 AND len(path) = len(timestamps)\n),\nclock AS (SELECT unnest(range(0, 2490, 10)) AS s)\nSELECT to_timestamp(1767225600 + s)              AS time,\n       count(*) FILTER (WHERE raw.vendor = 0)    AS \"Vendor 0\",\n       count(*) FILTER (WHERE raw.vendor = 1)    AS \"Vendor 1\"\nFROM clock LEFT JOIN raw ON s BETWEEN t_start AND t_end\nGROUP BY s\nORDER BY s",
          "refId": "A"
        }
      ],
      "title": "Taxis on the road",
      "type": "timeseries"
