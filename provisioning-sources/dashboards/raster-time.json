          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Una fila por pasada del satélite, cada una con su enlace a la imagen.\n-- Esto es a la vez el timeline (kepler monta su filtro temporal sobre `time`)\n-- y el catálogo del que sale la escena que se pinta: el panel dibuja la última\n-- que cae dentro de la ventana, sin volver a preguntar al servidor.\nWITH resp AS (\n  SELECT http_get(\n    'https://earth-search.aws.element84.com/v1/search'\n    || '?collections=sentinel-2-l2a'\n    || '&bbox=-79.10,-3.05,-78.90,-2.85'\n    || '&datetime=' || $__timeFrom() || '/' || $__timeTo()\n    || '&limit=400'\n  ) AS r\n),\nfeatures AS (\n  SELECT unnest(json_extract(r->>'body', '$.features[*]')) AS f FROM resp\n)\nSELECT\n  (f->'properties'->>'datetime')::TIMESTAMPTZ  AS time,\n  f->>'id'                                     AS scene_id,\n  (f->'properties'->>'eo:cloud_cover')::DOUBLE AS cloud_cover,\n  f->'assets'->'visual'->>'href'               AS raster_url\nFROM features\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Sentinel-2 over Cuenca · drag the time bar",
      "type": "ubica-keplergl-panel"
    },
