{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Maps by Kepler.gl",
  "id": "ubica-keplergl-panel",
  "info": {
    "keywords": [
      "panel",
      "map",
      "geospatial",
      "gis",
      "kepler",
      "kepler.gl",
      "deck.gl",
      "maplibre",
      "mobility",
      "trips",
      "flows",
      "geojson",
      "h3",
      "postgis",
      "spatial",
      "temporal",
      "spatio-temporal",
      "geoparquet"
    ],
    "description": "Interactive kepler.gl maps for Grafana dashboards — spatio-temporal data from any data source.",
    "author": {
      "name": "UBICA"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "kepler.gl",
        "url": "https://kepler.gl"
      }
    ],
    "screenshots": [
      {
        "name": "Global seismicity, read as remote GeoParquet by DuckDB",
        "path": "img/screenshot-quakes.png"
      },
      {
        "name": "Origin-destination flows built from query rows",
        "path": "img/screenshot-flows.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.0.10 <12.1 || >=12.1.7 <12.2 || >=12.2.5",
    "plugins": []
  }
}
